{
  "name": "clint-mcp-server",
  "version": "0.1.0",
  "description": "Servidor MCP local (stdio) que integra o Claude Code à API do CRM Clint",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clint-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
