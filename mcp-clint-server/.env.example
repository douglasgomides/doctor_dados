# Token de API da Clint (Conta > API > Copiar). Disponível apenas em contas
# no plano Elite. NUNCA versione o valor real deste token.
CLINT_API_TOKEN=your_clint_api_token_here

# Opcional. URL base da API da Clint. Só altere se a Clint fornecer uma URL
# diferente (ex.: ambiente de homologação).
# CLINT_API_BASE_URL=https://api.clint.digital

# Opcional. Timeout (em ms) aplicado a cada requisição HTTP à API da Clint.
# CLINT_API_TIMEOUT_MS=15000
