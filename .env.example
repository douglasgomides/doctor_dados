DB_HOST=postgres_postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# String aleatória com pelo menos 32 caracteres, usada para assinar a sessão
# de login. Gere com: openssl rand -base64 32
AUTH_SECRET=change_this_to_a_long_random_string

# Segredo exigido no header "x-init-secret" para chamar POST /api/db/init
# (provisiona a tabela de usuários e o admin inicial). Sem isso, qualquer
# pessoa na internet poderia (re)criar o usuário admin.
DB_INIT_SECRET=change_this_to_a_random_setup_secret

# Senha do usuário admin inicial (admin@dashboard.com), definida por você —
# não existe mais uma senha padrão fixa no código.
ADMIN_DEFAULT_PASSWORD=change_this_to_a_strong_password

# Chave da API da Anthropic (console.anthropic.com), usada pelo Clonador de
# Carrossel (/dashboard/carousel-tool) para analisar a imagem de referência
# enviada e extrair a estrutura do template automaticamente. Sem essa chave,
# a extração automática fica desabilitada (dá pra colar uma spec manualmente).
ANTHROPIC_API_KEY=sk-ant-your-key-here
