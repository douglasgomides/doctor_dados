DB_HOST=postgres_postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here

# String aleatória com pelo menos 32 caracteres, usada para assinar a sessão
# de login. Gere com: openssl rand -base64 32
AUTH_SECRET=change_this_to_a_long_random_string

# Segredo exigido no header "x-init-secret" para chamar POST /api/db/init
# (provisiona a tabela de usuários e o admin inicial). Sem isso, qualquer
# pessoa na internet poderia (re)criar o usuário admin.
DB_INIT_SECRET=change_this_to_a_random_setup_secret

# Senha do usuário admin inicial (admin@dashboard.com), definida por você —
# não existe mais uma senha padrão fixa no código.
ADMIN_DEFAULT_PASSWORD=change_this_to_a_strong_password

# Chave da API da Anthropic (console.anthropic.com). Usada pela análise de
# qualidade por IA de roteiros e reuniões, e pelo Clonador de Carrossel
# (/dashboard/carousel-tool) para extrair a estrutura do template a partir
# de uma imagem de referência. Sem essa chave, a extração automática do
# Clonador fica desabilitada (dá pra colar uma spec manualmente).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Segredo exigido no header "x-automation-secret" para chamar
# GET /api/automations/alerts e POST /api/automations/reunioes (lista de
# pendências/atrasos pro n8n disparar avisos de WhatsApp, e importação
# automática de transcrição de reunião). Sem isso, qualquer pessoa na
# internet poderia ler/escrever esses dados.
AUTOMATION_API_SECRET=change_this_to_a_random_automation_secret

# Token de API da Clint (Conta > API > Copiar, plano Elite). Usado só pelo
# endpoint POST /api/automations/clint-sync para sincronizar contatos e
# negócios da Clint para o Postgres local (o dashboard de inteligência
# comercial lê daqui, não da Clint diretamente).
CLINT_API_TOKEN=your_clint_api_token_here

# Segredo exigido no header "x-automation-secret" para chamar
# POST /api/automations/clint-sync. Próprio e separado do
# AUTOMATION_API_SECRET acima — assim dá pra girar esse segredo sem afetar
# as outras automações que já existem.
CLINT_SYNC_SECRET=change_this_to_a_random_secret

# Chave de API da Brevo (Account > SMTP & API > API Keys). Usada só pelo
# endpoint POST /api/automations/brevo-sync para sincronizar contatos e
# campanhas de e-mail da Brevo para o Postgres local (o dashboard de
# inteligência comercial cruza esses contatos com os leads da Clint por
# e-mail, não consulta a Brevo diretamente).
BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# Segredo exigido no header "x-automation-secret" para chamar
# POST /api/automations/brevo-sync. Próprio e separado do
# AUTOMATION_API_SECRET/CLINT_SYNC_SECRET acima.
BREVO_SYNC_SECRET=change_this_to_a_random_secret
